{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|woff|woff2|ttf|otf|eot)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "hasan-abbas-portfolio",
          "appId": "1:538757616550:android:cb9c0c0928cc4b9baef567",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "hasan-abbas-portfolio",
          "appId": "1:538757616550:ios:2135afcf1157d335aef567",
          "uploadDebugSymbols": true,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "hasan-abbas-portfolio",
          "appId": "1:538757616550:ios:2135afcf1157d335aef567",
          "uploadDebugSymbols": true,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "hasan-abbas-portfolio",
          "configurations": {
            "android": "1:538757616550:android:cb9c0c0928cc4b9baef567",
            "ios": "1:538757616550:ios:2135afcf1157d335aef567",
            "macos": "1:538757616550:ios:2135afcf1157d335aef567",
            "web": "1:538757616550:web:a3b0f65fadcb1f21aef567",
            "windows": "1:538757616550:web:d320e6f52a1e84d0aef567"
          }
        }
      }
    }
  }
}
