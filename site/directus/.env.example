# Copy to .env for local runs. On Hostinger, set these in the Node.js app panel.
# Never commit real values.

# 32+ character random strings
KEY=replace-with-random-key
SECRET=replace-with-random-secret

DB_CLIENT=mysql
# Use 127.0.0.1 when the Node app runs on the same host as MySQL;
# otherwise use the host shown in hPanel (for example auth-db1403.hstgr.io).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u124239009_portfolio
DB_USER=replace-with-dedicated-directus-user
DB_PASSWORD=replace-with-dedicated-directus-password

ADMIN_EMAIL=hasanabbassorathiya12@gmail.com
ADMIN_PASSWORD=replace-with-strong-admin-password

PUBLIC_URL=https://cms.hasanabbassorathiya.tech
HOST=0.0.0.0
IP_TRUST_PROXY=true
LOG_LEVEL=info
