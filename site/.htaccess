AddType application/manifest+json .webmanifest

# Compression (Apache; LiteSpeed on Hostinger compresses automatically)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/json application/manifest+json application/rss+xml text/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/manifest+json application/rss+xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect /favicon.ico → /favicon.svg (kill 404). Target must be absolute:
  # relative redirects get prefixed with the filesystem path in .htaccess.
  RewriteRule ^favicon\.ico$ /favicon.svg [L,R=301]

  # Pre-rendered route shells (correct meta for crawlers and link previews).
  # Shells live outside /blog and /apps/<slug> so those URLs stay directory-free.
  RewriteCond %{DOCUMENT_ROOT}/_views/blog/$1.html -f
  RewriteRule ^blog/([a-z0-9-]+)/?$ _views/blog/$1.html [L]
  RewriteCond %{DOCUMENT_ROOT}/blog.html -f
  RewriteRule ^blog/?$ blog.html [L]
  RewriteCond %{DOCUMENT_ROOT}/_views/apps/$1.html -f
  RewriteRule ^apps/([a-z0-9-]+)/?$ _views/apps/$1.html [L]
  RewriteCond %{DOCUMENT_ROOT}/apps.html -f
  RewriteRule ^apps/?$ apps.html [L]
  RewriteCond %{DOCUMENT_ROOT}/_views/work/$1.html -f
  RewriteRule ^work/([a-z0-9-]+)/?$ _views/work/$1.html [L]
  RewriteCond %{DOCUMENT_ROOT}/work.html -f
  RewriteRule ^work/?$ work.html [L]
  RewriteCond %{DOCUMENT_ROOT}/_views/services/$1.html -f
  RewriteRule ^services/([a-z0-9-]+)/?$ _views/services/$1.html [L]
  RewriteCond %{DOCUMENT_ROOT}/services.html -f
  RewriteRule ^services/?$ services.html [L]
  RewriteCond %{DOCUMENT_ROOT}/resources.html -f
  RewriteRule ^resources/?$ resources.html [L]
  RewriteCond %{DOCUMENT_ROOT}/resume.html -f
  RewriteRule ^resume/?$ resume.html [L]
  RewriteCond %{DOCUMENT_ROOT}/privacy.html -f
  RewriteRule ^privacy/?$ privacy.html [L]
  RewriteCond %{DOCUMENT_ROOT}/community.html -f
  RewriteRule ^community/?$ community.html [L]

  # Allow direct access to existing files
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # PHP admin panel must bypass the SPA
  RewriteRule ^admin(/|$) - [L]

  # Missing API paths must 404, never fall through to the SPA shell
  RewriteRule ^api(/|$) - [L]

  # CLI scripts and test harnesses are never public endpoints
  RewriteRule ^scripts(/|$) - [F,L]

  RewriteRule ^$ index.html [L]
  # Newly published CMS slugs may not have a build-time snapshot yet.
  RewriteRule ^(?:apps|blog|work)/[a-z0-9-]+/?$ index.html [L,QSA]
  RewriteRule ^ - [L,R=404]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

# Cache — immutable for hashed assets
<FilesMatch "\.(js|css|woff2)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(png|webp|jpg|jpeg|svg)$">
  Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>