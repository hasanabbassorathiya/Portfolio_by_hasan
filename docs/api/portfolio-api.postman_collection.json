{
  "info": {
    "name": "Portfolio CMS API",
    "description": "Complete API collection for Portfolio CMS - Supabase Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "portfolio-cms"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{JWT_TOKEN}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "https://your-project-id.supabase.co/rest/v1",
      "type": "string",
      "description": "Your Supabase project URL + /rest/v1. Get from Supabase Dashboard → Settings → API → Project URL"
    },
    {
      "key": "ANON_KEY",
      "value": "YOUR_SUPABASE_ANON_KEY",
      "type": "string",
      "description": "Your Supabase anon/public key. Get from Supabase Dashboard → Settings → API"
    },
    {
      "key": "JWT_TOKEN",
      "value": "",
      "type": "string",
      "description": "JWT token from admin login. Get from admin dashboard JWT Token Helper or Supabase Auth API"
    }
  ],
  "item": [
    {
      "name": "Public Endpoints",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{ANON_KEY}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/profiles",
              "host": ["{{BASE_URL}}"],
              "path": ["profiles"]
            }
          }
        },
        {
          "name": "Get All Works",
          "request": {
            "method": "GET",
