                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/works?is_active=eq.true&order=order_index.asc",
              "host": ["{{BASE_URL}}"],
              "path": ["works"],
              "query": [
                {
                  "key": "is_active",
                  "value": "eq.true"
                },
                {
                  "key": "order",
                  "value": "order_index.asc"
                }
              ]
