{
  "mcpServers": {
    "portfolio": {
      "command": "node",
      "args": ["site/scripts/portfolio-mcp.mjs"],
      "env": {
        "CMS_API_BASE": "https://hasanabbassorathiya.tech/api",
        "CMS_ADMIN_EMAIL": "admin@hasanabbassorathiya.tech"
      },
      "description": "Unified Portfolio MCP - All site operations: CMS content, media, CRM, build tools, file system. Use cms_auth_login for interactive auth or set CMS_API_TOKEN/CMS_API_CSRF for token auth."
    },
    "portfolio-cms": {
      "command": "node",
      "args": ["site/scripts/cms-mcp.mjs"],
      "env": {
        "CMS_API_BASE": "https://hasanabbassorathiya.tech/api"
      },
      "description": "Portfolio CMS API MCP server for content management, media, and CRM operations. Use cms_auth_login for interactive auth or set CMS_API_TOKEN/CMS_API_CSRF for token auth."
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--extension"
      ],
      "env": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "3uZJc7DXxpmY0Tmltjy6RNFV7QXCWmU5JRscL1j11BE"
      }
    },
    "claude-flow": {
      "command": "npx",
      "args": [
        "-y",
        "@claude-flow/cli@latest",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "autoStart": false
    }
  }
}