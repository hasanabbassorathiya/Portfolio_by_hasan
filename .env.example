# Turso Database
# Get your credentials at https://turso.tech
TURSO_URL=your_turso_database_url_here
TURSO_TOKEN=your_turso_auth_token_here

# Brevo (Sendinblue) - for contact form emails & newsletter
# Get your API key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
BREVO_NEWSLETTER_LIST_ID=2

# App Config
APP_NAME=Portfolio
DEFAULT_LOCALE=en
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
